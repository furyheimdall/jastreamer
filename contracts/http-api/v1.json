{
  "schema": 1,
  "contract": "jastreamer-http-api",
  "version": 1,
  "product_version": "0.2.0",
  "base_path": "/api/v1",
  "transport": {
    "origin": "same-origin",
    "authentication": "HttpOnly host-only SameSite=Strict session cookie; Secure on HTTPS",
    "mutation_header": {"X-Jastreamer-Request": "web"},
    "csrf": "validate Host and Origin on mutations",
    "http_scope": "private LAN only; credentials and content are unencrypted",
    "https": "optional configured PEM certificate and private key"
  },
  "error": {
    "shape": {"error": {"code": "string", "message": "safe user-facing string"}},
    "must_not_expose": ["absolute source paths", "signed media URLs", "credentials", "session IDs"]
  },
  "semantics": {
    "arrays": "never null",
    "revision_conflict_status": 409,
    "queue": "one global durable ordered queue; duplicate tracks retain distinct entries",
    "output": "one selected output shared by UPnP and AirPlay; output selection and pairing require stopped state",
    "pairing": "AirPlay setup uses an empty PairingRequest to begin, then a second request with the prompted PIN and/or password; credentials are write-only and never persisted by clients",
    "autoplay": "never on enqueue, startup, reconnect, scan, or output selection",
    "observation_failure": "mark status uncertain without revoking an existing stream; confirmed disconnection requires explicit resume",
    "natural_end": "correlated completion, or an owned terminal position repeatedly held for two seconds; the latter requires acknowledged Stop before advancement",
    "events": "invalidation only; clients refetch on open, gap, resync, and reconnect"
  },
  "routes": [
    {"method":"GET","path":"/healthz","auth":false,"response":{"status":"ready"}},
    {"method":"GET","path":"/api/v1/discovery","auth":false,"response":"Discovery"},
    {"method":"GET","path":"/api/v1/session","auth":false,"response":"Session"},
    {"method":"GET","path":"/api/v1/setup","auth":false,"response":{"required":"boolean"}},
    {"method":"POST","path":"/api/v1/setup","auth":false,"request":{"username":"string","password":"string"},"status":201,"response":{"user":"User"}},
    {"method":"POST","path":"/api/v1/login","auth":false,"request":{"username":"string","password":"string"},"response":{"user":"User"}},
    {"method":"POST","path":"/api/v1/logout","auth":true,"request":{},"status":204},
    {"method":"POST","path":"/api/v1/account/password","auth":true,"request":{"current_password":"string","new_password":"string"},"status":204},
    {"method":"GET","path":"/api/v1/config","auth":true,"response":{"config":"ServerConfig","revision":"string"}},
    {"method":"PUT","path":"/api/v1/config","auth":true,"request":{"config":"ServerConfig","revision":"string"},"response":{"config":"ServerConfig","revision":"string","restart_required":"boolean"}},
    {"method":"GET","path":"/api/v1/library/{tracks|albums|artists|genres|folders}","auth":true,"query":["q","album_id","artist","genre","root_id","path","sort","offset","limit"],"response":"Page"},
    {"method":"GET","path":"/api/v1/library/tracks/{id}","auth":true,"response":"Track"},
    {"method":"GET","path":"/api/v1/artwork/{id}","auth":true,"response":"image bytes"},
    {"method":"GET","path":"/api/v1/library/scans","auth":true,"response":{"items":"ScanJob[]"}},
    {"method":"POST","path":"/api/v1/library/scans","auth":true,"request":{},"status":202,"response":"ScanJob"},
    {"method":"DELETE","path":"/api/v1/library/scans/{id}","auth":true,"status":204},
    {"method":"GET","path":"/api/v1/playlists","auth":true,"response":{"items":"Playlist[]"}},
    {"method":"POST","path":"/api/v1/playlists","auth":true,"request":{"name":"string","track_ids":"string[]"},"status":201,"response":"Playlist"},
    {"method":"GET","path":"/api/v1/playlists/{id}","auth":true,"response":"Playlist"},
    {"method":"PUT","path":"/api/v1/playlists/{id}","auth":true,"request":{"name":"string","track_ids":"string[]","revision":"integer"},"response":"Playlist"},
    {"method":"DELETE","path":"/api/v1/playlists/{id}","auth":true,"query":["revision"],"status":204},
    {"method":"GET","path":"/api/v1/renderers","auth":true,"response":{"items":"Device[]"}},
    {"method":"POST","path":"/api/v1/renderers/refresh","auth":true,"request":{},"status":202},
    {"method":"POST","path":"/api/v1/renderers/{id}/pairing","auth":true,"request":"PairingRequest","response":"PairingStatus"},
    {"method":"GET","path":"/api/v1/player","auth":true,"response":"PlayerState"},
    {"method":"POST","path":"/api/v1/player","auth":true,"request":{"action":"play|pause|stop|next|previous|seek","entry_id":"string?","position_ms":"integer?"},"status":202,"response":"PlayerState"},
    {"method":"PUT","path":"/api/v1/player/output","auth":true,"request":{"renderer_id":"string"},"response":"PlayerState"},
    {"method":"GET","path":"/api/v1/queue","auth":true,"response":"Queue"},
    {"method":"POST","path":"/api/v1/queue","auth":true,"request":{"action":"append|next|replace|remove|move|clear","track_ids":"string[]?","entry_id":"string?","index":"integer?","revision":"integer"},"response":"Queue"},
    {"method":"GET","path":"/api/v1/events","auth":true,"response":"SSE change events"}
  ],
  "models": {
    "User":{"id":"string","username":"string"},
    "Discovery":{"product":"jastreamer","protocol":1,"id":"stable UUID","name":"configured server_name or hostname","version":"product version"},
    "Session":{"authenticated":"boolean","user":"User?"},
    "Root":{"id":"string","name":"string","path":"absolute path in Server configuration only"},
    "Track":{"id":"string","title":"string","artist":"string","album":"string","album_artist":"string","album_id":"string","disc":"integer","track":"integer","genres":"string[]","duration_ms":"integer","format":"string","mime":"string","artwork_id":"string","root_id":"string","path":"root-relative string","available":"boolean","size":"integer","modified_at":"string"},
    "Album":{"id":"string","title":"string","artist":"string","artwork_id":"string","track_count":"integer"},
    "Artist":{"id":"string","name":"string","track_count":"integer"},
    "Genre":{"id":"string","name":"string","track_count":"integer"},
    "Folder":{"root_id":"string","path":"string","name":"string","track_count":"integer"},
    "Page":{"items":"array","total":"integer","offset":"integer","limit":"integer"},
    "Playlist":{"id":"string","name":"string","revision":"integer","track_ids":"string[]","tracks":"Track[]","updated_at":"string"},
    "ScanJob":{"id":"string","state":"queued|running|complete|failed|cancelled","started_at":"string","finished_at":"string","scanned":"integer","changed":"integer","error":"string"},
    "Capabilities":{"play":"boolean","pause":"boolean","stop":"boolean","seek":"boolean"},
    "Device":{"id":"string","name":"string","protocol":"upnp|airplay","manufacturer":"string","model":"string","address":"string","online":"boolean","last_seen":"string","capabilities":"Capabilities","protocol_info":"string[]","pairing_required":"boolean","password_required":"boolean"},
    "PairingRequest":{"pin":"string?","password":"string?"},
    "PairingStatus":{"required":"boolean","prompt":"string"},
    "QueueEntry":{"id":"string","track_id":"string","track":"Track","status":"pending|playing|completed|error"},
    "Queue":{"revision":"integer","entries":"QueueEntry[]"},
    "PlayerState":{"revision":"integer","state":"stopped|starting|playing|paused|unavailable|error","renderer_id":"string","current_entry_id":"string","track":"Track|null","position_ms":"integer","duration_ms":"integer","observed_at":"string","pending_command":"string","error":"string","capabilities":"Capabilities"},
    "ServerConfig":{"version":1,"data_dir":"absolute path","server_name":"optional display name; empty uses hostname","http":{"enabled":"boolean","address":"string"},"https":{"enabled":"boolean","address":"string","certificate_file":"absolute path or empty when disabled","private_key_file":"absolute path or empty when disabled"},"library_roots":"Root[]","network":{"interfaces":"string[]","discovery_interval_seconds":"integer","poll_interval_seconds":"integer","allowed_cidrs":"string[]"},"media":{"base_url":"string","ffmpeg_path":"absolute path or empty","transcode":"boolean"},"airplay":{"enabled":"boolean","helper_path":"absolute path or empty when disabled"}},
    "ChangeEvent":{"event":"change","id":"monotonic integer","data":{"type":"player|queue|library|playlists|renderers|config|resync"}}
  }
}
