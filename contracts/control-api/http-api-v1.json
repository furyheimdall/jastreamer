{
  "version": "http-api-v1",
  "protocolMajors": [1, 2],
  "authentication": {"scheme": "Bearer", "tokenStorage": "sha256", "roles": ["public", "controller", "admin"]},
  "routes": [
    {"method":"GET","path":"/healthz","role":"public","success":[200],"errors":[],"response":["status"]},
    {"method":"GET","path":"/pair/","role":"public","success":[200],"errors":[],"response":["text/html"]},
    {"method":"GET","path":"/api/v1/identity","role":"public","success":[200],"errors":[],"response":["common_name","sha256_fingerprint","pairing_url"]},
    {"method":"POST","path":"/api/v1/bootstrap","role":"public","success":[201],"errors":["BOOTSTRAP_COMPLETE","BOOTSTRAP_SECRET_INVALID","INVALID_REQUEST"],"request":{"fields":["setup_secret","name"]},"response":["token","device"]},
    {"method":"POST","path":"/api/v1/pairing-codes","role":"admin","success":[201],"errors":["UNAUTHORIZED","TOKEN_REVOKED","ADMIN_REQUIRED"],"request":{"fields":[]},"response":["code","expires_at"],"mutation":"single-use code expires after five minutes"},
    {"method":"POST","path":"/api/v1/pairings","role":"public","success":[201],"errors":["PAIRING_CODE_INVALID","PAIRING_CODE_EXPIRED","PAIRING_CODE_USED","PAIRING_RATE_LIMITED","INVALID_REQUEST"],"request":{"fields":["code","name"]},"response":["token","device"],"mutation":"consume code once and create controller"},
    {"method":"GET","path":"/api/v1/devices","role":"admin","success":[200],"errors":["UNAUTHORIZED","TOKEN_REVOKED","ADMIN_REQUIRED"],"response":["devices"]},
    {"method":"DELETE","path":"/api/v1/devices/{deviceId}","role":"admin","success":[204],"errors":["UNAUTHORIZED","TOKEN_REVOKED","ADMIN_REQUIRED","NOT_FOUND"],"mutation":"revoke device token"},
    {"method":"GET","path":"/api/v1/discovery","role":"controller","success":[200],"errors":["UNAUTHORIZED","TOKEN_REVOKED","UNSUPPORTED_PROTOCOL_MAJOR"],"request":{"headers":["X-Jake-Protocol-Major"]},"response":["supported_protocol_majors","capabilities","pairing_url","certificate_sha256","contract_revision","algorithm_revision","analysis_revision","catalog_revision"]},
    {"method":"GET","path":"/api/v1/catalog/status","role":"controller","success":[200],"errors":["UNAUTHORIZED","TOKEN_REVOKED"],"response":["scan_status","catalog_revision","track_count","analysis_complete","analysis_queued","analysis_failed","analysis_coverage","analysis_revision"]},
    {"method":"POST","path":"/api/v1/catalog/scans","role":"admin","success":[202],"errors":["UNAUTHORIZED","TOKEN_REVOKED","ADMIN_REQUIRED"],"mutation":"scan and persist authoritative catalog"},
    {"method":"GET","path":"/api/v1/zones/{zoneId}/queue","role":"controller","success":[200],"errors":["UNAUTHORIZED","TOKEN_REVOKED"],"response":["zone_id","revision","transport","queue"]},
    {"method":"POST","path":"/api/v1/zones/{zoneId}/queue","role":"controller","success":[200,201],"errors":["UNAUTHORIZED","TOKEN_REVOKED","IDEMPOTENCY_KEY_REQUIRED","REVISION_REQUIRED","STALE_REVISION","IDEMPOTENCY_CONFLICT","INVALID_REQUEST"],"request":{"headers":["Idempotency-Key","If-Match"],"fields":["tracks"]},"response":["revision","entry_ids"],"mutation":"idempotent append with optimistic concurrency"},
    {"method":"GET","path":"/api/v1/zones/{zoneId}/playback-state","role":"controller","success":[200],"errors":["UNAUTHORIZED","TOKEN_REVOKED"],"response":["zone_id","revision","transport","queue"]},
    {"method":"GET","path":"/api/v1/zones/{zoneId}/continuation-policy","role":"controller","success":[200],"errors":["UNAUTHORIZED","TOKEN_REVOKED"],"response":["mode","artist_gap","album_gap","revision","session_override","ETag"]},
    {"method":"PATCH","path":"/api/v1/zones/{zoneId}/continuation-policy","role":"controller","success":[200],"errors":["UNAUTHORIZED","TOKEN_REVOKED","REVISION_REQUIRED","STALE_POLICY_REVISION","INVALID_REQUEST"],"request":{"headers":["If-Match"],"fields":["mode","artist_gap","album_gap","session_override"]},"response":["mode","artist_gap","album_gap","revision","session_override","ETag"],"mutation":"bounded gaps and optimistic concurrency"},
    {"method":"GET","path":"/api/v1/zones/{zoneId}/automatic-preview","role":"controller","success":[200],"errors":["UNAUTHORIZED","TOKEN_REVOKED"],"response":["active","replaceable","committed","decision"]},
    {"method":"GET","path":"/api/v1/zones/{zoneId}/decision-explanation","role":"controller","success":[200],"errors":["UNAUTHORIZED","TOKEN_REVOKED"],"response":["decision_id","kind","reason","source","track_id","algorithm_revision","catalog_revision","policy_revision","contract_revision","signal_coverage","recording_key","explanation"]},
    {"method":"GET","path":"/api/v1/events","role":"controller","success":[101],"errors":["UNAUTHORIZED","TOKEN_REVOKED","WEBSOCKET_UPGRADE_REQUIRED","INVALID_WEBSOCKET_HANDSHAKE"],"request":{"headers":["Connection: Upgrade","Upgrade: websocket","Sec-WebSocket-Version: 13","Sec-WebSocket-Key","Sec-WebSocket-Protocol"]},"response":["initial state frame","post-mutation state frames"],"stream":"WSS until disconnect"}
  ],
  "httpErrors": {"BOOTSTRAP_COMPLETE":409,"BOOTSTRAP_SECRET_INVALID":401,"UNAUTHORIZED":401,"TOKEN_REVOKED":401,"ADMIN_REQUIRED":403,"PAIRING_CODE_INVALID":400,"PAIRING_CODE_EXPIRED":410,"PAIRING_CODE_USED":409,"PAIRING_RATE_LIMITED":429,"INVALID_REQUEST":400,"IDEMPOTENCY_KEY_REQUIRED":428,"REVISION_REQUIRED":428,"STALE_REVISION":409,"IDEMPOTENCY_CONFLICT":409,"STALE_POLICY_REVISION":412,"UNSUPPORTED_PROTOCOL_MAJOR":426,"WEBSOCKET_UPGRADE_REQUIRED":426,"INVALID_WEBSOCKET_HANDSHAKE":400,"NOT_FOUND":404},
  "tlsErrors": {"CERTIFICATE_MISMATCH":{"layer":"client-tls-verification","httpStatus":null}},
  "reasonEnums": ["PLAY_EXPLICIT","PLAY_ALBUM","PLAY_SIMILAR","BLOCK_EXPLICIT","STOP_MODE_OFF","STOP_NO_ALBUM","STOP_ALBUM_COMPLETE","STOP_SIMILAR_NO_SIGNAL","STOP_SIMILAR_EXHAUSTED","STOP_AUTO_FAILURE_LIMIT"]
}
