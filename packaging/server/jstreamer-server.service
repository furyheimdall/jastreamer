[Unit]
Description=Jake Streamer Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jstreamer
Group=jstreamer
EnvironmentFile=-/etc/jstreamer/server.env
ExecStart=/usr/lib/jstreamer-server/jstreamer-server --config /etc/jstreamer/server.json
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jstreamer

[Install]
WantedBy=multi-user.target
