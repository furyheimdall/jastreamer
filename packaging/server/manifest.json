{
  "schema": 1,
  "component": "server",
  "package": "jastreamer-server",
  "image": "ghcr.io/furyheimdall/jastreamer-server",
  "license": "Apache-2.0",
  "tag_pattern": "server-v<major>.<minor>.<patch>",
  "floating_tags": false,
  "operational_capabilities": {
    "admin_config": "/api/v1/config",
    "secure_pairing": "/api/v1/pairing-codes",
    "catalog_browse": "/api/v1/catalog/tracks",
    "original_media": "original-first",
    "l16_transcode": "external-ffmpeg-pcm-s16be",
    "l16_sink_selection": "renderer-protocol-info",
    "k17_scope": "FiiO K17 V261+",
    "synology_compose": "deploy/docker/server/compose.synology.yaml",
    "synology_backup_restore": "data-and-config-bind-mounts",
    "windows_service": "jastreamer-server",
    "publication_guard": "default-deny",
    "promotion_gate": "signed-product-promotion-gate-v1"
  },
  "native_artifacts": [
    "jastreamer-server_<version>_windows_amd64.exe",
    "jastreamer-server_<version>_windows_amd64.msi",
    "jastreamer-server_<version>_linux_amd64.deb",
    "jastreamer-server_<version>_linux_amd64.rpm",
    "jastreamer-server_<version>_linux_arm64.deb",
    "jastreamer-server_<version>_linux_arm64.rpm",
    "jastreamer-server_<version>_linux_amd64-arm64.oci"
  ],
  "required_records": [
    "SHA256SUMS",
    "PROVENANCE.intoto.json",
    "<artifact>.spdx.json",
    "Apache-2.0.txt",
    "THIRD_PARTY_NOTICES",
    "server.cer",
    "fingerprint.txt",
    "trust.md",
    "remove-trust.md",
    "windows-msi-inspection.json",
    "linux-amd64-inspection.json",
    "linux-arm64-inspection.json",
    "oci-inspection.json",
    "promotion-ledger.json"
  ],
  "windows": {
    "publisher": "CN=jastreamer",
    "certificate_ca": false,
    "eku": "Code Signing",
    "local_surface": "cross-compiled EXE and wixl-built MSI under QEMU; no trust claim",
    "release_surface": "official WiX 6.0.2 and Windows SDK SignTool on windows-latest"
  },
  "linux": {
    "packager": "nFPM 2.43.4",
    "service_manager": "systemd",
    "service_user": "jastreamer"
  }
}
