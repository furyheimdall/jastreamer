{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://jastreamer.invalid/schemas/product-gate-supply-chain/v1","$defs":{
    "spdx":{"type":"object","additionalProperties":false,"required":["spdxVersion","dataLicense","SPDXID","name","documentNamespace","creationInfo","packages","files","relationships"],"properties":{"spdxVersion":{"const":"SPDX-2.3"},"dataLicense":{"const":"CC0-1.0"},"SPDXID":{"const":"SPDXRef-DOCUMENT"},"name":{"type":"string","minLength":1},"documentNamespace":{"type":"string","format":"uri"},"creationInfo":{"type":"object","required":["created","creators"]},"packages":{"type":"array","minItems":1},"files":{"type":"array","minItems":1},"relationships":{"type":"array","minItems":2}}},
    "slsa":{"type":"object","additionalProperties":false,"required":["_type","subject","predicateType","predicate"],"properties":{"_type":{"const":"https://in-toto.io/Statement/v1"},"subject":{"type":"array","minItems":1},"predicateType":{"const":"https://slsa.dev/provenance/v1"},"predicate":{"type":"object","required":["buildDefinition","runDetails"],"properties":{"buildDefinition":{"type":"object","required":["buildType","externalParameters","resolvedDependencies"]},"runDetails":{"type":"object","required":["builder"]}}}}}
  }
}
