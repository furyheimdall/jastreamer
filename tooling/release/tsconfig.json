{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "typeRoots": [
      "../../packaging/server/node_modules/@types",
      "../../packaging/server/node_modules"
    ],
    "noEmit": true
  },
  "include": ["*.ts", "*.d.mts"]
}
