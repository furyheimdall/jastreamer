#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "$#" -eq 2 ] && [ "$1" = "verify-boundaries" ] && [ "$2" = "--all" ]; then
  exec node "$root/tooling/verify-boundaries.mjs"
fi
if [ "$#" -ge 2 ] && [ "$1" = "policy" ] && [ "$2" = "verify" ]; then
  exec bun "$root/tooling/policy/cli.ts" "$@"
fi
if [ "$#" -ge 2 ] && [ "$1" = "synology" ]; then
  shift
  exec node "$root/deploy/synology/cli.mjs" "$@"
fi
if [ "$#" -ge 2 ] && [ "$1" = "contracts" ]; then
  shift
  exec bun "$root/contracts/tooling/cli.ts" "$@"
fi
if [ "$#" -ge 3 ] && [ "$1" = "qa" ] && [ "$2" = "pairing-api" ]; then
  shift 2
  exec "$root/tooling/qa/pairing-api.sh" "$@"
fi
if [ "$#" -ge 3 ] && [ "$1" = "qa" ] && [ "$2" = "control" ]; then
  shift 2
  exec "$root/tooling/qa/control.sh" "$@"
fi
if [ "$#" -ge 3 ] && [ "$1" = "release" ] && [ "$2" = "validate" ]; then
  shift 2
  exec bun "$root/tooling/release/cli.ts" "$@"
fi
if [ "$#" -eq 2 ] && [ "$1" = "test" ] && [ "$2" = "candidates" ]; then
  cd "$root/apps/server"
  JSTREAMER_ROOT="$root" exec go run ./tooling/candidate-smoke.go \
    "$root/tooling/fixtures/music" "$root/apps/server/migrations/001_catalog.sql"
fi
if [ "$#" -eq 4 ] && [ "$1" = "test" ] && [ "$2" = "candidates" ]; then
  cd "$root/apps/server"
  JSTREAMER_ROOT="$root" exec go run ./tooling/candidate-smoke.go "$root/$3" "$root/$4"
fi
if [ "$#" -ge 3 ] && [ "$1" = "test" ] && [ "$2" = "analysis-parity" ]; then
  shift 2
  cd "$root/apps/server"
  JSTREAMER_ROOT="$root" exec go run ./tooling/analysis-parity.go "$@"
fi
if [ "$#" -ge 3 ] && [ "$1" = "test" ] && [ "$2" = "ranking-parity" ]; then
  shift 2
  cd "$root/apps/server"
  JSTREAMER_ROOT="$root" exec go run ./tooling/ranking-parity.go "$@"
fi
printf '%s\n' 'usage: tooling/componentctl <verify-boundaries|isolation|component|policy|synology|contracts|release|test|qa>' >&2
exit 64
